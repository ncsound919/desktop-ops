# Desktop-Ops environment configuration
# Copy to .env and fill in. Never commit .env.

# LLM (desktop has no GPU - uses phone mesh or cloud fallback)
# DESKTOP_OPS_MESH_URL=http://<phone-ip>:8788
# DESKTOP_OPS_CLOUD_URL=https://api.openai.com
# DESKTOP_OPS_CLOUD_KEY=sk-...

# Telemetry (optional - POSTs EcosystemEvent v1 facts)
# DESKTOP_OPS_TELEMETRY_URL=https://sieve-ingest.../ecosystem/event

# OpenHub MCP (approvals, receipts)
# DESKTOP_OPS_OPENHUB_URL=http://<openhub-host>:3000
# DESKTOP_OPS_OPENHUB_TOKEN=

# GitHub (for PR creation)
# GITHUB_TOKEN=ghp_...

# Services
# KOKORO_URL=http://127.0.0.1:8880
# LISTMONK_URL=http://127.0.0.1:9000
# LISTMONK_USER=admin
# LISTMONK_PASS=
# UMAMI_URL=http://127.0.0.1:3001
# UMAMI_TOKEN=

# Paths
# BLOG_DIR=./blog

# Budget
# DESKTOP_OPS_DAILY_BUDGET=5.0